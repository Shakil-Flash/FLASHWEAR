# Settings modules: config.settings.{development,staging,testing,production}.
# staging = production behaviour with short HSTS and report-only CSP (a deploy rehearsal).
# production (and therefore staging) refuses to boot without: SECRET_KEY (non-development),
# ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, DATABASE_URL (postgres://), REDIS_URL, PAYMENT_PROVIDER
# (not "development"), PAYMENT_WEBHOOK_SECRET, and EMAIL_HOST when EMAIL_BACKEND is SMTP.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-development-only-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,testserver,web

# Database (PostgreSQL via Docker Compose by default)
DATABASE_URL=postgres://flashwear:flashwear@db:5432/flashwear

# Redis / Cache / Celery
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
USE_REDIS=False
CACHE_KEY_PREFIX=flashwear
CACHE_TTL_SECONDS=300

# Security / Proxy
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PORT=False
# Only enable behind a proxy that overwrites X-Forwarded-For on every request, otherwise the
# per-IP sign-in counter sees the proxy address and becomes a global counter.
USE_X_FORWARDED_FOR=False

# Sign-in throttling (failures only; a success clears the counters)
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=300

# Customer accounts (Phase 2)
# "Keep me signed in" on the login form. Keep this above SESSION_COOKIE_AGE, otherwise unticking
# the box changes nothing and the checkbox is decoration.
ACCOUNT_REMEMBER_ME_DAYS=30
SESSION_COOKIE_AGE=1209600
# Lifetime of the emailed verification and password-reset links, in seconds (3 days).
PASSWORD_RESET_TIMEOUT=259200
# Absolute base for links in transactional email. Leave empty to fall back to the current Site.
ACCOUNT_EMAIL_BASE_URL=
# Avatar uploads are validated by content with Pillow before they are stored.
ACCOUNT_AVATAR_MAX_BYTES=2097152
ACCOUNT_AVATAR_MAX_PIXELS=4096
ACCOUNT_AVATAR_ALLOWED_FORMATS=JPEG,PNG,WEBP
# Accounts deactivated longer than this are eligible for
# ``manage.py anonymise_deactivated_accounts``. Compliance floor, not a marketing setting.
ACCOUNT_DATA_RETENTION_DAYS=30

# Catalogue (Phase 3)
# Image uploads are validated by content with Pillow *before* they are stored, and SVG is rejected
# outright: an SVG is executable markup and must never land under a path a browser will run.
CATALOG_IMAGE_MAX_BYTES=6291456
CATALOG_IMAGE_MAX_PIXELS=6000
CATALOG_IMAGE_ALLOWED_FORMATS=JPEG,PNG,WEBP
# Storefront page size, and the API's default and ceiling. The ceiling matters: without it,
# ?page_size=100000 turns the catalogue endpoint into a full-table dump.
CATALOG_PRODUCTS_PER_PAGE=12
CATALOG_API_PAGE_SIZE=24
CATALOG_API_MAX_PAGE_SIZE=100
# Sibling products on the "you may also like" strip. Merchandising, not search.
CATALOG_RELATED_PRODUCTS_LIMIT=4
# Phase 3 prices are plain decimal amounts with no per-product currency column: one storefront
# trades in one currency until multi-currency pricing arrives with checkout. The symbol shown in
# templates is derived from this code (USD/EUR/GBP/BDT/INR/AED are mapped; anything else prints
# the code itself).
CATALOG_CURRENCY_CODE=USD

# Cart & checkout (Phase 5)
# Per-line quantity cap for the bag. The server enforces this; the quantity input's max
# attribute is rendered from the same setting so the two can never disagree.
CART_MAX_QUANTITY_PER_ITEM=99
# Shipping rates. Amounts are settings, not database rows: checkout resolves the cost
# server-side from the customer's subtotal, so nothing a browser posts can change one.
# Standard delivery costs the flat rate and is free at or above the threshold; express
# always costs the express rate.
CHECKOUT_SHIPPING_FLAT_RATE=5.00
CHECKOUT_SHIPPING_FREE_OVER=100.00
CHECKOUT_SHIPPING_EXPRESS_RATE=15.00

# API
API_ANON_THROTTLE_RATE=60/min
API_PAGE_SIZE=24

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FLASHWEAR <no-reply@flashwear.local>
SERVER_EMAIL=FLASHWEAR <no-reply@flashwear.local>

# Static / Media
STATIC_URL=/static/
STATIC_ROOT=./staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=./media

# Timezone
TZ=UTC
LANGUAGE_CODE=en-us

# Logging
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
LOG_DIR=./logs
DISABLE_FILE_LOGGING=False
# Rotation limits. Production defaults are larger; override per deployment.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
SECURITY_LOG_BACKUP_COUNT=10

# CORS (future mobile/SPA)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=True

# Inventory (Phase 6)
# How long a checkout hold keeps its units before the sweeper returns them to the shop floor.
INVENTORY_RESERVATION_MINUTES=30
# Celery beat interval (seconds) for inventory.sweep_expired_reservations: abandoned checkout
# holds are returned to the pool; holds attached to a placed order are never swept.
INVENTORY_SWEEP_INTERVAL_SECONDS=60

# Payments (Phase 6)
# Provider implementation. "development" simulates the whole flow with no external calls, which
# is what the payment page's simulate buttons drive. Production settings refuse it, and refuse an
# unknown name at startup rather than at the first checkout.
PAYMENT_PROVIDER=
# HMAC key for calling a real provider's API (unused by the development provider).
PAYMENT_SECRET_KEY=
# Signs webhook bodies: X-Flashwear-Signature is sha256 of "<timestamp>." + raw body under this
# key. Empty falls back to SECRET_KEY in development; production requires it explicitly.
PAYMENT_WEBHOOK_SECRET=
# Deliveries timestamped older than this (seconds) are refused as replays.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Engagement: reviews, loyalty & promotions (Phase 7)
# FLASH Points earned per unit spent, applied to the discounted subtotal. A purchase that is
# 100% covered by a promotion earns nothing, so points can never be printed from thin air.
LOYALTY_EARN_RATE=10
# Redemption rate: this many points take exactly 1.00 off the order.
LOYALTY_REDEEM_RATE=100
# Points are redeemed in this step only, so balances stay on round numbers and the form's
# increment attribute matches the server's validation exactly.
LOYALTY_REDEEM_INCREMENT=100
# Hard cap on what points can cover, as a percentage of the pre-discount subtotal. Default
# keeps a points-only order paying at least half its value.
LOYALTY_MAX_REDEEM_PERCENT=50
# Orders below this amount cannot redeem points at all (0.00 = no floor).
LOYALTY_MIN_ORDER_AMOUNT=0.00
# Days until earned points expire. Expiry pauses entirely while the customer has an open
# checkout hold, so an expiry sweep can never take points out from under a live checkout.
LOYALTY_EXPIRY_DAYS=365
# How long a checkout holds points. Mirrors the inventory hold so both expire together.
LOYALTY_RESERVATION_MINUTES=30
# Reviews per product page.
REVIEWS_PER_PAGE=6
# Celery beat interval (seconds) for engagement.sweep_loyalty: expires due points and
# releases abandoned holds. Holds attached to a placed order are never swept.
LOYALTY_SWEEP_INTERVAL_SECONDS=60

# Future integrations (Phase 4+)
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False

AI_PROVIDER=
AI_API_KEY=
AI_EMBEDDING_MODEL=

ADMIN_EMAIL=engineering@flashwear.local
LOGIN_URL=/accounts/login/

# --------------------------------------------------------------------------------------
# Observability (Phase 18)
# --------------------------------------------------------------------------------------
# "plain" logs human-readable lines (development default); "json" emits one JSON object
# per line so a log shipper can parse it (production default). Deliberately unset here:
# an explicit value in this file would override the per-environment default on both
# sides (copying "plain" into production would ship unparseable logs).
# LOG_FORMAT=
# When set (and ``sentry-sdk`` is installed) errors are forwarded to Sentry; empty keeps
# the built-in logging fallback. The DSN is a write-only key -- treat it like a password.
SENTRY_DSN=
# 0.0 records errors only; a small fraction (0.05-0.2) adds performance traces. Every 1.0
# traces every request, which is a sampling bill, not a setting.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --------------------------------------------------------------------------------------
# TLS / proxy hardening (production and staging)
# --------------------------------------------------------------------------------------
# Redirect any http:// request to https://. Only switch this off when TLS terminates
# somewhere that has already redirected, otherwise the redirect loop lands here.
SECURE_SSL_REDIRECT=True
# One year of HSTS with subdomains and preload. Careful: browsers honour a preload list
# for months after removal, so do not enable include-subdomains/preload on a host that
# will ever serve plain HTTP.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Signed session/CSRF cookies (itsdangerous) so a cookie's contents cannot be edited
# client-side. Costs a signature check per request; only an intermediary that cannot
# verify signatures would want this off.
SECURE_SERIALIZATION_COOKIE=True
# "Lax" lets top-level navigations carry the cookie (email links) while blocking
# cross-site POSTs. "Strict" breaks arriving from an external link; "None" requires
# Secure and is only for cross-site embeds -- we have neither need.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Watch CSP violations without blocking: True reports to the browser console (and any
# report-uri) so a new inline script can be found before customers hit it; False
# enforces the policy immediately. Left unset so each environment keeps its default:
# development and staging watch, production enforces. Set it explicitly only to change
# that (e.g. staging enforcing like production for a deploy rehearsal).
# CSP_REPORT_ONLY=

# Database (production connection behaviour)
# Persistent connections: seconds a pooled connection may live before Django recycles
# it. 0 = close every connection (safe, slower under load).
CONN_MAX_AGE=60
# TCP connect timeout in seconds so an unreachable database fails the request promptly
# instead of hanging a worker until Gunicorn's timeout kills it.
DB_CONNECT_TIMEOUT=10
# sslmode for the production database: require/prefer/verify-full depending on whether
# the database is on a private network. verify-full also checks the server certificate.
DB_SSLMODE=prefer

# Cache failure behaviour. True lets a cache outage degrade to a database read (a slow
# page) instead of a 500 on every request; the trade-off is that cache errors are then
# invisible until someone reads the logs.
CACHE_IGNORE_EXCEPTIONS=True

# --------------------------------------------------------------------------------------
# Email (production: SMTP; development/console backends ignore these)
# --------------------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --------------------------------------------------------------------------------------
# Gunicorn / containers (gunicorn.conf.py reads these from the process environment)
# --------------------------------------------------------------------------------------
# Listen port inside the container (the compose file maps it).
PORT=8000
# Worker processes. Rule of thumb: (2 x CPU cores) + 1. Each worker holds its own
# connections and memory -- this is the first knob to turn when a container OOMs.
WEB_CONCURRENCY=3
# Seconds before a worker is killed and restarted. Must be larger than the slowest
# request you expect, and GUNICORN_TIMEOUT should exceed CELERY-like worst cases only
# for web requests; a timeout here is a worker restart, not a task failure.
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
# Restart a worker after this many requests to cap memory growth from leaks. Workers
# finish in-flight requests before retiring (graceful), so this is invisible to users.
GUNICORN_MAX_REQUESTS=1000

# --------------------------------------------------------------------------------------
# Auth attempt throttles (register / resend verification / password reset)
# --------------------------------------------------------------------------------------
# Generic limiter applied on top of the sign-in counters: how many failed attempts per
# window before these forms answer 429. Deliberately generous -- the point is to stop
# automated token grinding, not to inconvenience a customer who mistyped twice.
ACCOUNT_ATTEMPT_MAX=10
ACCOUNT_ATTEMPT_WINDOW_SECONDS=3600

# --------------------------------------------------------------------------------------
# Celery task behaviour (Phase 18)
# --------------------------------------------------------------------------------------
# Hard wall-clock kill for a task (seconds); the soft limit raises an exception first so
# the task can log where it was. A task stuck on a dead provider is a worker slot gone
# forever without these.
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
# Retry policy for tasks that ask for retries: base delay, exponential backoff factor,
# backoff ceiling and a cap on attempts. Bounded on purpose -- an unbounded retry of a
# permanently broken dependency is a queue full of poison messages.
CELERY_TASK_DEFAULT_RETRY_DELAY=30
CELERY_TASK_RETRY_BACKOFF=2
CELERY_TASK_RETRY_BACKOFF_MAX=600
CELERY_TASK_MAX_RETRIES=3
# How long a result stays in the backend. Nothing polls results, so keep this short:
# every second of expiry is Redis memory you are not paying for.
CELERY_RESULT_EXPIRES=3600

# --------------------------------------------------------------------------------------
# Notifications (Phase 17)
# --------------------------------------------------------------------------------------
# Delivery attempts before a notification is parked as failed (ops can requeue it from
# /operations/notifications/). Backoff between attempts is capped, and a row whose
# worker died mid-send is declared stuck after NOTIFICATIONS_STUCK_SECONDS.
NOTIFICATIONS_MAX_EMAIL_ATTEMPTS=3
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=60
NOTIFICATIONS_RETRY_MAX_SECONDS=3600
NOTIFICATIONS_STUCK_SECONDS=600
# Row retention: in-app rows live 90 days, email delivery rows a year (longer, because
# they are the receipt for "did we tell the customer"). The sweeps that enforce this
# run on their own intervals below.
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_EMAIL_RETENTION_DAYS=365
NOTIFICATIONS_EXPIRING_WARNING_DAYS=7
# Broadcasts are inserted in batches of this size so a campaign to every customer is
# many small transactions, not one lock-the-table insert.
NOTIFICATIONS_BROADCAST_BATCH_SIZE=500
# "django" renders through the configured email backend (locmem in tests, SMTP or
# console in real runs). A provider-specific backend would be added behind this knob.
NOTIFICATIONS_EMAIL_PROVIDER=django
# Per-user caps on bulk endpoints: mark-read-all, preference saves and unsubscribes
# each accept at most this many ids per request, so one POST cannot become a full scan.
NOTIFICATIONS_READ_ALL_MAX=10
NOTIFICATIONS_PREFERENCES_MAX=20
NOTIFICATIONS_UNSUBSCRIBE_MAX=10
# Coarse per-user throttle window on notification-triggering endpoints (seconds).
NOTIFICATIONS_THROTTLE_WINDOW_SECONDS=300
# Celery beat intervals for the four notification sweeps: queue (stuck/failed rows back
# into motion), retention (delete expired rows), drop events (close ended-drop rows),
# points-expiring (warn before the ledger expires a balance).
NOTIFICATIONS_QUEUE_SWEEP_INTERVAL_SECONDS=300
NOTIFICATIONS_RETENTION_SWEEP_INTERVAL_SECONDS=21600
NOTIFICATIONS_DROP_SWEEP_INTERVAL_SECONDS=300
NOTIFICATIONS_POINTS_SWEEP_INTERVAL_SECONDS=86400

# --------------------------------------------------------------------------------------
# Support desk
# --------------------------------------------------------------------------------------
# Ticket/message rate limits inside SUPPORT_MESSAGE_WINDOW_SECONDS (abuse, not signup).
SUPPORT_MAX_TICKETS_PER_WINDOW=5
SUPPORT_MAX_MESSAGES_PER_WINDOW=30
SUPPORT_MESSAGE_WINDOW_SECONDS=300
SUPPORT_MAX_ATTACHMENTS_PER_MESSAGE=5
SUPPORT_TICKETS_PER_PAGE=20
# Attachments are validated by content (Pillow/dimension checks) before storage; the
# allow-list is extensions the desk accepts, and the root sits OUTSIDE MEDIA_ROOT so a
# customer upload is never web-served directly.
SUPPORT_ATTACHMENT_MAX_BYTES=5242880
SUPPORT_ATTACHMENT_MAX_PIXELS=8000
SUPPORT_ATTACHMENT_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.txt
# Storage root for attachments, deliberately outside MEDIA_ROOT. Left unset: an explicit
# empty value here would replace the default (private/support/) with the empty string.
# SUPPORT_ATTACHMENT_ROOT=
# Auto-close tickets parked on the customer after 14 days; remind them first after 3.
# Reminders are off by default: an email that nags a customer who meant to reply is a
# product decision, so turn it on deliberately.
SUPPORT_CLOSE_AFTER_DAYS=14
SUPPORT_REMIND_AFTER_DAYS=3
SUPPORT_SEND_REMINDERS=False
SUPPORT_SWEEP_INTERVAL_SECONDS=3600

# --------------------------------------------------------------------------------------
# Loop (resale / trade-in)
# --------------------------------------------------------------------------------------
# Listings expire after 90 days (a resale listing nobody refreshes is stale inventory
# shown as live); at most 5 images per listing; both beat sweeps share one interval.
# Eligible brands gate who may list, and the recyclable lists drive the trade-in quote.
LOOP_LISTING_TTL_DAYS=90
LOOP_MAX_IMAGES=5
LOOP_SWEEP_INTERVAL_SECONDS=3600
LOOP_ELIGIBLE_BRAND_SLUGS=flashwear
LOOP_RECYCLABLE_CATEGORIES=t-shirts,hoodies,jeans,dresses
LOOP_RECYCLABLE_MATERIALS=organic-cotton,cotton,polyester,wool
LOOP_RESALE_MIN_PRICE=1.00
LOOP_RESALE_MAX_PRICE=50000.00
LOOP_TRADE_IN_BASE_VALUE=20.00

# --------------------------------------------------------------------------------------
# Quests / gamification
# --------------------------------------------------------------------------------------
# Beat interval for quests.sweep_progress (streaks and progress windows roll over).
QUESTS_SWEEP_INTERVAL_SECONDS=300

# --------------------------------------------------------------------------------------
# Back-office operations (/operations/)
# --------------------------------------------------------------------------------------
# Page size for desk lists, and the alert thresholds the dashboard surfaces. These are
# operational sensitivity knobs: raise the thresholds when a busier shop starts firing
# alerts nobody can act on, lower them when something important slipped through.
BACKOFFICE_PAGE_SIZE=25
BACKOFFICE_LOW_STOCK_THRESHOLD=5
BACKOFFICE_ALERT_PAYMENT_FAILURES=3
BACKOFFICE_STALE_PAYMENT_MINUTES=60
BACKOFFICE_ALERT_CANCELLED_ORDERS=5
BACKOFFICE_REVIEW_BACKLOG=20
BACKOFFICE_SLA_WAITING_DAYS=3
BACKOFFICE_DROP_ENDING_HOURS=24
# Fire the "promotion near its usage cap" alert at 90% consumed.
BACKOFFICE_PROMOTION_LIMIT_FRACTION=0.9

# --------------------------------------------------------------------------------------
# Object storage (production alternative to local MEDIA_ROOT)
# --------------------------------------------------------------------------------------
# Required when STORAGE_BACKEND is s3/minio/object. Credentials are write-only secrets:
# never put them in this file in a real deployment -- inject them from the platform's
# secret store (compose secrets, Kubernetes secrets, vault, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
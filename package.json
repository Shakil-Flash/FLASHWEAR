{
  "name": "flashwear-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for the FLASHWEAR storefront.",
  "scripts": {
    "build:css": "tailwindcss --input ./frontend/css/tailwind.css --output ./static/css/app.css --minify",
    "watch:css": "tailwindcss --input ./frontend/css/tailwind.css --output ./static/css/app.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
{
    "profile": "django",
    "indent": 4,
    "max_line_length": 500,
    "max_attribute_length": 500,
    "max_css_attribute_length": 500,
    "max_blank_lines": 1,
    "preserve_blank_lines": true,
    "line_break_after_multiline_tag": true,
    "blank_line_after_tag": "never",
    "format_css": true,
    "format_js": true,
    "close_void_tags": true,
    "use_editorconfig": false,
    "ignore": "H006,H031,staticfiles,node_modules",
    "extend_exclude": ".kilo,.venv,staticfiles,node_modules,media,logs"
}